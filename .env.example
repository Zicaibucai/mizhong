# ==============================================================================
# 环境变量示例 — 复制为 `.env.local` 后填入真实值
# 重要：本文件不含任何真实密钥；切勿将含真实密钥的 `.env*` 提交到版本库。
# 生产环境请通过服务器环境变量或密钥管理服务注入，勿写入代码仓库。
# ==============================================================================

# ---- 站点（域名由客户提供后替换）----
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- 数据库 PostgreSQL（本阶段必需：后台登录与内容管理）----
# 本地示例：postgresql://postgres:postgres@localhost:5432/mizhong?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mizhong?schema=public

# ---- 对象存储（阿里云 OSS / S3 兼容）----
# 阶段 3 接入，本阶段代码不读取这些变量
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- 会话密钥（预留）----
# 当前会话采用「数据库存储会话 + 随机令牌」，不使用签名密钥；预留供后续功能使用。
# 生成方式：openssl rand -base64 32
AUTH_SECRET=
