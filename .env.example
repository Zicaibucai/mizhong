# ==============================================================================
# 环境变量示例 — 复制为 `.env.local` 后填入真实值
# 重要：本文件不含任何真实密钥；切勿将含真实密钥的 `.env*` 提交到版本库。
# 生产环境请通过服务器环境变量或密钥管理服务注入，勿写入代码仓库。
# ==============================================================================

# ---- 站点（域名由客户提供后替换）----
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- 数据库 PostgreSQL（本阶段必需：后台登录与内容管理）----
# 本地示例：postgresql://postgres:postgres@localhost:5432/mizhong?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mizhong?schema=public

# ---- 对象存储（阿里云 OSS / S3 兼容）----
# 阶段 3 接入，本阶段代码不读取这些变量
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- 素材存储 ----
# local = 服务器本地磁盘（当前使用）；oss = 阿里云 OSS（接口已预留，尚未实现）
STORAGE_DRIVER=local
# 上传根目录：必须位于 Git 仓库之外，重新部署不会删除素材
UPLOAD_DIR=/opt/mizhong-data/uploads
# 对外访问前缀（由 Nginx 映射到 UPLOAD_DIR）
MEDIA_PUBLIC_BASE=/media

# ---- 会话密钥（预留）----
# 当前会话采用「数据库存储会话 + 随机令牌」，不使用签名密钥；预留供后续功能使用。
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# 会话 Cookie 的 Secure 标记（可选，一般留空）
# 留空时自动跟随实际协议（Nginx 的 X-Forwarded-Proto）：HTTPS 下为 true，HTTP 下为 false。
# 仅在反向代理未传递 X-Forwarded-Proto 时才需要手动指定 true/false。
SESSION_COOKIE_SECURE=

# ---- 语言翻译（DeepSeek）----
# 后台「翻译设置」里填的值优先于这里；这里配好可以在首次部署时就可用。
# API Key 会在数据库里以 AES-256-GCM 加密存储，明文永不落库、不进日志。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 加密数据库里那把 Key 的密钥（AES-256-GCM）。
# 生成方式：openssl rand -base64 32
# **改动它会导致已存的 Key 解不开**（后台会显示「无法解密」，翻译自动停用，
# 不会拿半截垃圾去发请求）。丢了就重新在后台填一次 API Key。
TRANSLATION_ENCRYPTION_KEY=

# ---- 严格语言回退开关（默认关闭）----
# 关闭（不设 / 0 / false）：任意一条翻译都可兜底 —— 现状行为。商品缺某语言译文时，
#                          该语言页面显示其它语言的内容，而不是 404。
# 开启（1 / true）：中文页面只认中文，其它语言只回退英文，两者都没有则 404；
#                  hreflang 与 sitemap 也只列真正有内容的语言。
#
# **开启前必须先完成全站翻译。** 否则「N 个只有中文的商品 × 10 种语言」这些原本
# 返回 200 的地址会一起变成 404。顺序是：先翻译 → 验证各语言页面 → 再置为 true。
STRICT_LOCALE_FALLBACK=
