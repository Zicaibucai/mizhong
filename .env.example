# ==============================================================================
# 环境变量示例 — 复制为 `.env.local` 后填入真实值
# 重要：本文件不含任何真实密钥；切勿将含真实密钥的 `.env*` 提交到版本库。
# 生产环境请通过服务器环境变量或密钥管理服务注入，勿写入代码仓库。
# ==============================================================================

# ---- 站点（域名由客户提供后替换）----
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# ---- 数据库 PostgreSQL（下一阶段接入）----
# 阿里云香港 ECS 或托管 PostgreSQL 连接串
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mizhong?schema=public

# ---- 对象存储（S3 兼容 / 阿里云 OSS，下一阶段接入）----
S3_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
S3_REGION=cn-hongkong
S3_BUCKET=mizhong-media
# 以下密钥由部署时注入，请勿写入本仓库：
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OSS/CDN 公开访问域名（素材对外 URL 前缀）
S3_PUBLIC_BASE_URL=https://cdn.example.com

# ---- 后台认证（下一阶段接入）----
# 生成随机值：openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=
