// 米众贸易有限公司 — 数据模型
//
// 本阶段（阶段 2）：数据库 + 管理员认证 + 基础内容管理后台。
// 尚未接入：OSS 素材上传、DeepSeek 翻译、询盘邮件、图片 SEO、服务器部署。
//
// 接入步骤：
//   1. 配置 DATABASE_URL（.env.local，参见 .env.example）
//   2. npm run db:generate      # 生成 Prisma Client
//   3. npm run db:migrate       # 应用迁移（需可用的 PostgreSQL）
//   4. npm run db:seed          # 导入首页初始内容
//   5. npm run admin:create     # 创建管理员账号（交互式，不写入源码）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 通用枚举
// ---------------------------------------------------------------------------

/// 内容语言（全站统一的翻译关联维度，禁止为每种语言硬编码字段）
/// 内容语言。与 src/lib/i18n/config.ts 的 `locales` 数组一一对应，两边必须同时改。
/// 新增语言只需追加成员 —— 所有翻译表都以这个枚举为外键，追加是纯新增操作。
enum Locale {
  zh
  en
  vi
  es
  ja
  ru
  ar
  fr
  ko
  pt
  hi
}

/// 发布状态
enum PublishStatus {
  DRAFT
  PUBLISHED
}

// ---------------------------------------------------------------------------
// 译文同步（全站统一）
//
// 中文是唯一母版。每个「内容 × 语言」有一条 TranslationState，记录该语言的译文
// 是从**哪一版中文**翻出来的、以及**逐个字段**的同步明细。
//
// 这一层刻意做成通用的：商品、页面、首页区块、公司资料、联系方式、导航、
// 类目、素材 alt 文字……全部共用同一张表、同一套状态机、同一个后台页面。
// 每加一种内容类型就加一张表，会让「全站同步」变成 N 份彼此不同步的实现。
// ---------------------------------------------------------------------------

/// 一个「内容 × 语言」的译文同步状态
enum TranslationStatus {
  /// 译文与当前中文一致
  SYNCED
  /// 中文改过了，译文待重新生成
  STALE
  /// 正在翻译（用于并发互斥与进度展示）
  TRANSLATING
  /// 上次翻译失败，等待重试
  FAILED
}

/// 中文内容的版本号。
///
/// 只用于「这批译文是从哪一版中文翻出来的」这一件事：中文内容一变，版本号 +1，
/// 所有语言的译文随即变成 STALE。整数而非哈希，是为了在后台能直接写「中文版本 3」，
/// 也为了发布时能一眼看出「所有批次是不是同一个 sourceRevision」。
model ContentRevision {
  entityType String
  entityId   String
  /// 从 1 开始，每次中文内容真正变化时 +1
  revision   Int      @default(1)
  /// 当前中文内容的哈希，用来判断「到底变没变」——没变就不该 +1
  sourceHash String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@id([entityType, entityId])
}

/// 一条「内容 × 语言」的同步记录。字段级明细存在 `fields` JSON 里。
///
/// `fields` 的形状：`{ [字段路径]: { hash, status, at, model } }`。
/// 路径是**稳定的字符串**（`translations.name`、
/// `specTable.rows.<行id>.cells.<列id>`），不是数组下标 ——
/// 增删一行不会让整份状态错位（需求 8.4）。
model TranslationState {
  id         String @id @default(cuid())
  entityType String
  entityId   String
  locale     Locale

  /// 本语言译文对应的中文版本
  sourceRevision Int  @default(0)
  /// 逐字段明细
  fields         Json @default("{}")

  /// 汇总状态（只要有一个字段不是 SYNCED，这里就不是 SYNCED）
  status           TranslationStatus @default(STALE)
  translatedAt     DateTime?
  translationModel String?
  /// 最近一次失败的原因（已归类，不含 Key、原文或译文）
  lastError        String?
  /// 连续失败次数，用于退避与「只重试失败内容」
  failureCount     Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([entityType, status])
  @@index([entityType, entityId])
}

/// 一次成功发布的记录。
///
/// 存在的意义是回答「这一版线上内容里，中文和各语言是不是同一次发布出去的」。
/// 商品与页面各自的版本快照都带上 `releaseId`，因此回滚时能整组还原。
enum ReleaseStatus {
  PUBLISHED
  FAILED
}

model ContentRelease {
  id         String @id @default(cuid())
  entityType String
  entityId   String
  /// 本次发布钉住的中文版本（所有批次必须来自这一版，需求 8.5）
  revision   Int

  /// 实际参与本次发布的语言（含中文）
  locales Locale[]
  /// 发布摘要：每种语言翻了多少字段、用的哪个模型、耗时
  result  Json?

  status        ReleaseStatus @default(PUBLISHED)
  model         String?
  publishedById String?
  publishedBy   User?         @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([entityType, entityId, publishedAt])
  @@index([publishedById])
}

enum TranslationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  /// 部分成功：成功的已保留，失败的可以只重试那一部分
  PARTIAL
  FAILED
  CANCELLED
}

enum TranslationJobKind {
  /// 发布时自带的同步：中文变了也要一起上线
  PUBLISH
  /// 后台对单条内容点「同步」
  SYNC_ONE
  /// 后台「同步全部已发布中文内容」
  SYNC_ALL
  /// 只重试失败项
  RETRY_FAILED
}

enum TranslationItemStatus {
  PENDING
  RUNNING
  SYNCED
  FAILED
  /// 不需要处理（中文源为空、或该语言无需写入）
  SKIPPED
}

/// 长任务。
///
/// 首页与全站内容的翻译可能超过单个 Server Action 的时限，因此**不**把它塞进
/// 一个长时间挂着的请求里：任务与进度落在数据库，每次推进只处理一小批（远低于 60 秒），
/// 关掉浏览器不会损坏任何东西，重新打开继续看到进度（需求 8）。
model TranslationJob {
  id     String               @id @default(cuid())
  kind   TranslationJobKind
  status TranslationJobStatus @default(PENDING)

  /// 幂等键：同一个键只创建一个任务，重复点击不会重复翻译（需求 7.9）
  idempotencyKey String? @unique

  totalItems     Int @default(0)
  completedItems Int @default(0)
  failedItems    Int @default(0)
  requestCount   Int @default(0)
  /// token 估算：把原文与译文的字符数按经验系数折算，用于后台对账
  tokenEstimate  Int @default(0)

  /// 推进锁。取锁失败的调用方直接返回当前进度而不是排队 —— 全站同步按钮
  /// 连点两下不该把同一批内容翻两遍（需求 十三.5）。超时的锁可以被后来者接管，
  /// 免得进程被杀之后任务卡死在 RUNNING 上。
  lockedAt  DateTime?
  lastError String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  items TranslationJobItem[]

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([createdById])
}

/// 任务里的一个「内容 × 语言」工作项。逐个语言独立记录成功/失败，
/// 因此部分失败时成功的部分**在数据库里已经落定**，重试只处理 FAILED 的那些。
model TranslationJobItem {
  id    String         @id @default(cuid())
  jobId String
  job   TranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  locale     Locale
  /// 该工作项对应的中文版本；与 job 一起保证「同一批次的来源一致」
  revision   Int
  /// 稳定的处理顺序。断点续跑按它推进 —— 位置一旦确定就不再变化，
  /// 因此中途插入新内容不会让「已经跑到第几个」变得没有意义。
  sortOrder  Int    @default(0)

  status        TranslationItemStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?
  requestCount  Int                   @default(0)
  tokenEstimate Int                   @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([jobId, entityType, entityId, locale])
  @@index([jobId, status])
  @@index([jobId, sortOrder])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// 管理员与登录会话
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         Role      @default(EDITOR)
  enabled      Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  productVersions ProductVersion[]
  pageVersions    PageVersion[]
  releases        ContentRelease[]
  translationJobs TranslationJob[]
}

/// 登录会话（仅存储令牌哈希，原始令牌只存在于 HttpOnly Cookie 中）
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

/// 操作审计记录
enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     AuditAction
  targetType String
  targetId   String?
  summary    String?
  detail     Json?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// 站点设置 / 公司资料 / 联系方式
// ---------------------------------------------------------------------------

/// 键值形式的全局设置（站点 URL、默认语言、SEO 默认值等）
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// 公司资料（单例，slug 固定为 primary）
model CompanyProfile {
  id        String   @id @default(cuid())
  slug      String   @unique @default("primary")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CompanyProfileTranslation[]
}

model CompanyProfileTranslation {
  id        String         @id @default(cuid())
  profileId String
  profile   CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  locale    Locale

  name           String
  tagline        String?
  about          String?
  positioning    String?
  address        String?
  businessHours  String?
  seoTitle       String?
  seoDescription String?

  @@unique([profileId, locale])
}

/// 联系方式类型
enum ContactType {
  EMAIL
  WHATSAPP
  PHONE
  WECHAT
  ADDRESS
}

/// 联系方式（未启用或未填写时，前台不展示）
model ContactMethod {
  id        String      @id @default(cuid())
  /// 稳定标识：由 seed 写入，用于幂等创建；后台手动新增的记录为 null
  key       String?     @unique
  type      ContactType
  value     String?
  href      String?
  enabled   Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  translations ContactMethodTranslation[]

  @@index([sortOrder])
}

model ContactMethodTranslation {
  id              String        @id @default(cuid())
  contactMethodId String
  contactMethod   ContactMethod @relation(fields: [contactMethodId], references: [id], onDelete: Cascade)
  locale          Locale

  label String?
  value String?

  @@unique([contactMethodId, locale])
}

// ---------------------------------------------------------------------------
// 导航
// ---------------------------------------------------------------------------

model NavItem {
  id        String   @id @default(cuid())
  href      String
  external  Boolean  @default(false)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations NavItemTranslation[]

  @@index([sortOrder])
}

model NavItemTranslation {
  id        String  @id @default(cuid())
  navItemId String
  navItem   NavItem @relation(fields: [navItemId], references: [id], onDelete: Cascade)
  locale    Locale
  label     String

  @@unique([navItemId, locale])
}

// ---------------------------------------------------------------------------
// 页面与区块
// ---------------------------------------------------------------------------

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  status    PublishStatus @default(DRAFT)
  isHome    Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  /// 编辑草稿，形状与 PageVersion.snapshot 相同（见 src/lib/page-draft.ts）。
  /// 与商品同一套做法：null 表示没有待发布的改动，此时编辑器直接编辑线上内容。
  draftData      Json?
  draftUpdatedAt DateTime?

  translations PageTranslation[]
  blocks       PageBlock[]
  versions     PageVersion[]

  @@index([status])
}

/// 一个页面的历史版本（含首页）。
///
/// 与 ProductVersion 同一形状、同一套「发布留一版、回滚产生新版本」的规则，
/// 只是快照的内容是页面 + 它的全部区块（见 src/lib/page-draft.ts）。
/// `releaseId` 把这一版与同一次发布的中文、各语言串在一起，回滚时整组还原。
model PageVersion {
  id        String             @id @default(cuid())
  pageId    String
  page      Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  kind      ProductVersionKind
  /// 该版本的完整内容快照（页面信息 + 全部区块，含全部语言）
  snapshot  Json
  releaseId String?
  note      String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([pageId, createdAt])
  @@index([createdById])
}

model PageTranslation {
  id             String  @id @default(cuid())
  pageId         String
  page           Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  seoTitle       String?
  seoDescription String?

  @@unique([pageId, locale])
}

/// 页面区块。key 为语义标识（hero / capabilities / products / supply / quality / inquiry …），
/// 与前台组件一一对应，后台可编辑标题、正文、按钮文字与显示状态。
model PageBlock {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  type      String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageBlockTranslation[]

  @@unique([pageId, key])
  @@index([sortOrder])
}

model PageBlockTranslation {
  id       String    @id @default(cuid())
  blockId  String
  block    PageBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  locale   Locale
  title    String?
  subtitle String?
  body     String?
  ctaLabel String?
  ctaHref  String?

  @@unique([blockId, locale])
}

// ---------------------------------------------------------------------------
// 素材库
// ---------------------------------------------------------------------------

enum AssetType {
  IMAGE
  VIDEO
}

/// 存储后端。local = 服务器本地磁盘（当前使用）；oss = 阿里云 OSS 接口已预留
enum StorageDriver {
  LOCAL
  OSS
}

model Asset {
  id           String        @id @default(cuid())
  type         AssetType
  driver       StorageDriver @default(LOCAL)
  /// 对象 key（本地为相对路径，OSS 为 object key）
  key          String        @unique
  url          String
  /// 生成的缩略图（图片）
  thumbnailUrl String?
  /// 视频封面
  posterUrl    String?
  mimeType     String
  originalName String?
  width        Int?
  height       Int?
  size         Int?
  enabled      Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  translations       AssetTranslation[]
  slots              SlotBinding[]
  productMedia       ProductMedia[]
  productCovers      Product[]          @relation("ProductCover")
  productHoverVideos Product[]          @relation("ProductHoverVideo")
  categoryCovers     ProductCategory[]  @relation("CategoryCover")

  @@index([type])
  @@index([enabled])
  @@index([sortOrder])
}

model AssetTranslation {
  id      String  @id @default(cuid())
  assetId String
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  locale  Locale
  title   String?
  caption String?
  alt     String?

  @@unique([assetId, locale])
}

/// 语义化槽位：把素材绑定到固定页面位置（如 brand.logo、hero.image）
model SlotBinding {
  id       String @id @default(cuid())
  slot     String
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position Int    @default(0)

  @@unique([slot, position])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// 产品
// ---------------------------------------------------------------------------

model ProductCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  coverAssetId String?
  coverAsset   Asset?   @relation("CategoryCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     Product[]
  translations CategoryTranslation[]

  @@index([enabled])
  @@index([sortOrder])
}

model CategoryTranslation {
  id          String          @id @default(cuid())
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?

  @@unique([categoryId, locale])
}

/// 商品图库中素材的用途
enum ProductMediaRole {
  GALLERY
  VIDEO
}

/// 价格模式：决定前台展示方式与后台必填项
enum PriceMode {
  /// 面议 / Contact for price —— 不展示数字价格
  NEGOTIABLE
  /// 固定价格 —— 使用 priceMin
  FIXED
  /// 价格区间 —— 使用 priceMin 与 priceMax
  RANGE
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  sku          String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverAssetId String?
  coverAsset   Asset?           @relation("ProductCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  featured     Boolean          @default(false)
  published    Boolean          @default(false)
  sortOrder    Int              @default(0)

  // ---- 价格与贸易信息（金额一律使用 Decimal，绝不使用 Float）----
  priceMode PriceMode @default(NEGOTIABLE)
  /// 计价货币：ISO 4217 代码（USD / CNY / VND / EUR）
  currency  String    @default("USD")
  /// 固定价格；区间价格的下限
  priceMin  Decimal?  @db.Decimal(12, 2)
  /// 区间价格的上限（仅 RANGE 使用）
  priceMax  Decimal?  @db.Decimal(12, 2)
  /// 计价单位：piece / meter / yard / roll / kg / set
  priceUnit String?
  /// 最小起订量
  moq       Int?
  /// 起订单位：与 priceUnit 取值一致
  moqUnit   String?

  /// 列表卡片鼠标悬停时播放的视频（必须引用 VIDEO 类型素材）
  hoverVideoAssetId String?
  hoverVideoAsset   Asset?  @relation("ProductHoverVideo", fields: [hoverVideoAssetId], references: [id], onDelete: SetNull)

  // ---- 草稿 ----
  //
  // 本模型上的各列、ProductTranslation、ProductSpecification、ProductMedia 一起构成
  // **线上内容** —— 前台读的就是它们，发布是唯一写入点。
  //
  // 后台的编辑先写进 draftData，与线上完全隔离：客人永远看不到改到一半的样子。
  // null 表示「没有待发布的改动」，此时编辑器直接编辑线上内容。
  /// 编辑草稿，形状与 ProductVersion.snapshot 相同（见 src/lib/product-draft.ts）
  draftData      Json?
  draftUpdatedAt DateTime?

  /// 发布后的可配置规格/颜色表，列和单元格内容按三种语言保存
  specTable Json?

  /// 发布后的型号/颜色选项组；每个选项可绑定一张缩略图
  variantGroups Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations   ProductTranslation[]
  media          ProductMedia[]
  specifications ProductSpecification[]
  versions       ProductVersion[]

  @@index([published])
  @@index([featured])
  @@index([categoryId])
  @@index([sortOrder])
  @@index([hoverVideoAssetId])
}

/// 商品图库：有序、带用途的素材关联
model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role      ProductMediaRole @default(GALLERY)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@unique([productId, assetId, role])
  @@index([productId, sortOrder])
  @@index([assetId])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           Locale
  name             String
  shortDescription String?
  description      String?
  /// 尺寸摘要（如「宽 25mm × 厚 2mm」），独立于自由文本规格
  sizeSummary      String?
  spec             String?
  application      String?
  seoTitle         String?
  seoDescription   String?

  @@unique([productId, locale])
}

// ---------------------------------------------------------------------------
// 结构化商品参数
// ---------------------------------------------------------------------------

/// 一条可排序的商品参数（如材质、宽度、厚度、颜色、包装方式）。
/// 结构为 1 个商品 : N 条参数，每条参数三语言各一行翻译 —— 管理员可自由增删改排序，
/// 不允许把参数硬编码成固定数据库字段。
model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ProductSpecificationTranslation[]

  @@index([productId, sortOrder])
}

model ProductSpecificationTranslation {
  id              String               @id @default(cuid())
  specificationId String
  specification   ProductSpecification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  locale          Locale
  /// 参数名称（材质、宽度…）
  name            String
  /// 参数值
  value           String?

  @@unique([specificationId, locale])
}

/// 版本来源：发布时自动留下的，还是管理员手动存档的。
/// 商品（ProductVersion）与页面（PageVersion）共用这一对取值。
enum ProductVersionKind {
  PUBLISHED
  MANUAL
}

/**
 * 商品的历史版本。
 * 每次「发布」自动留一版，管理员也可以随时手动存档一版。每个商品**最多保留 3 个**，
 * 超出后最早的被挤掉（见 src/lib/admin/actions/products.ts 的 trimVersions）。
 * 自动保存本身**不**产生版本 —— 否则几秒一存，三个名额只会是最近几秒的连续快照，
 * 回滚毫无意义。
 * 恢复一个版本时，内容写回 Product.draftData 而**不是**直接改线上：
 * 恢复后它成为「待发布的改动」，确认无误再点发布，误点也能再退回去。
 */
model ProductVersion {
  id        String             @id @default(cuid())
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      ProductVersionKind
  /// 该版本的完整内容快照，与 Product.draftData 同一形状
  snapshot  Json
  /// 手动存档时可填备注
  note      String?
  /// 这次发布对应的 ContentRelease.id。同一版线上内容的中文与各语言共用它，
  /// 因此「这一版是不是同一次发布出去的」可以直接查证。
  releaseId String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// 询盘（本阶段仅保留模型，表单与邮件在阶段 5）
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  locale    String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([createdAt])
}
