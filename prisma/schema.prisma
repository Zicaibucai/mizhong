// 米众贸易有限公司 — 数据模型
//
// 本阶段（阶段 2）：数据库 + 管理员认证 + 基础内容管理后台。
// 尚未接入：OSS 素材上传、DeepSeek 翻译、询盘邮件、图片 SEO、服务器部署。
//
// 接入步骤：
//   1. 配置 DATABASE_URL（.env.local，参见 .env.example）
//   2. npm run db:generate      # 生成 Prisma Client
//   3. npm run db:migrate       # 应用迁移（需可用的 PostgreSQL）
//   4. npm run db:seed          # 导入首页初始内容
//   5. npm run admin:create     # 创建管理员账号（交互式，不写入源码）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 通用枚举
// ---------------------------------------------------------------------------

/// 内容语言（全站统一的翻译关联维度，禁止为每种语言硬编码字段）
enum Locale {
  zh
  en
  vi
}

/// 发布状态
enum PublishStatus {
  DRAFT
  PUBLISHED
}

// ---------------------------------------------------------------------------
// 管理员与登录会话
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         Role      @default(EDITOR)
  enabled      Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  productVersions ProductVersion[]
}

/// 登录会话（仅存储令牌哈希，原始令牌只存在于 HttpOnly Cookie 中）
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

/// 操作审计记录
enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     AuditAction
  targetType String
  targetId   String?
  summary    String?
  detail     Json?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// 站点设置 / 公司资料 / 联系方式
// ---------------------------------------------------------------------------

/// 键值形式的全局设置（站点 URL、默认语言、SEO 默认值等）
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// 公司资料（单例，slug 固定为 primary）
model CompanyProfile {
  id        String   @id @default(cuid())
  slug      String   @unique @default("primary")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CompanyProfileTranslation[]
}

model CompanyProfileTranslation {
  id        String         @id @default(cuid())
  profileId String
  profile   CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  locale    Locale

  name           String
  tagline        String?
  about          String?
  positioning    String?
  address        String?
  businessHours  String?
  seoTitle       String?
  seoDescription String?

  @@unique([profileId, locale])
}

/// 联系方式类型
enum ContactType {
  EMAIL
  WHATSAPP
  PHONE
  WECHAT
  ADDRESS
}

/// 联系方式（未启用或未填写时，前台不展示）
model ContactMethod {
  id        String      @id @default(cuid())
  /// 稳定标识：由 seed 写入，用于幂等创建；后台手动新增的记录为 null
  key       String?     @unique
  type      ContactType
  value     String?
  href      String?
  enabled   Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  translations ContactMethodTranslation[]

  @@index([sortOrder])
}

model ContactMethodTranslation {
  id              String        @id @default(cuid())
  contactMethodId String
  contactMethod   ContactMethod @relation(fields: [contactMethodId], references: [id], onDelete: Cascade)
  locale          Locale

  label String?
  value String?

  @@unique([contactMethodId, locale])
}

// ---------------------------------------------------------------------------
// 导航
// ---------------------------------------------------------------------------

model NavItem {
  id        String   @id @default(cuid())
  href      String
  external  Boolean  @default(false)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations NavItemTranslation[]

  @@index([sortOrder])
}

model NavItemTranslation {
  id        String  @id @default(cuid())
  navItemId String
  navItem   NavItem @relation(fields: [navItemId], references: [id], onDelete: Cascade)
  locale    Locale
  label     String

  @@unique([navItemId, locale])
}

// ---------------------------------------------------------------------------
// 页面与区块
// ---------------------------------------------------------------------------

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  status    PublishStatus @default(DRAFT)
  isHome    Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations PageTranslation[]
  blocks       PageBlock[]

  @@index([status])
}

model PageTranslation {
  id             String  @id @default(cuid())
  pageId         String
  page           Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  seoTitle       String?
  seoDescription String?

  @@unique([pageId, locale])
}

/// 页面区块。key 为语义标识（hero / capabilities / products / supply / quality / inquiry …），
/// 与前台组件一一对应，后台可编辑标题、正文、按钮文字与显示状态。
model PageBlock {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  type      String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageBlockTranslation[]

  @@unique([pageId, key])
  @@index([sortOrder])
}

model PageBlockTranslation {
  id       String    @id @default(cuid())
  blockId  String
  block    PageBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  locale   Locale
  title    String?
  subtitle String?
  body     String?
  ctaLabel String?
  ctaHref  String?

  @@unique([blockId, locale])
}

// ---------------------------------------------------------------------------
// 素材库
// ---------------------------------------------------------------------------

enum AssetType {
  IMAGE
  VIDEO
}

/// 存储后端。local = 服务器本地磁盘（当前使用）；oss = 阿里云 OSS 接口已预留
enum StorageDriver {
  LOCAL
  OSS
}

model Asset {
  id           String        @id @default(cuid())
  type         AssetType
  driver       StorageDriver @default(LOCAL)
  /// 对象 key（本地为相对路径，OSS 为 object key）
  key          String        @unique
  url          String
  /// 生成的缩略图（图片）
  thumbnailUrl String?
  /// 视频封面
  posterUrl    String?
  mimeType     String
  originalName String?
  width        Int?
  height       Int?
  size         Int?
  enabled      Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  translations       AssetTranslation[]
  slots              SlotBinding[]
  productMedia       ProductMedia[]
  productCovers      Product[]          @relation("ProductCover")
  productHoverVideos Product[]          @relation("ProductHoverVideo")
  categoryCovers     ProductCategory[]  @relation("CategoryCover")

  @@index([type])
  @@index([enabled])
  @@index([sortOrder])
}

model AssetTranslation {
  id      String  @id @default(cuid())
  assetId String
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  locale  Locale
  title   String?
  caption String?
  alt     String?

  @@unique([assetId, locale])
}

/// 语义化槽位：把素材绑定到固定页面位置（如 brand.logo、hero.image）
model SlotBinding {
  id       String @id @default(cuid())
  slot     String
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position Int    @default(0)

  @@unique([slot, position])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// 产品
// ---------------------------------------------------------------------------

model ProductCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  coverAssetId String?
  coverAsset   Asset?   @relation("CategoryCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     Product[]
  translations CategoryTranslation[]

  @@index([enabled])
  @@index([sortOrder])
}

model CategoryTranslation {
  id          String          @id @default(cuid())
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?

  @@unique([categoryId, locale])
}

/// 商品图库中素材的用途
enum ProductMediaRole {
  GALLERY
  VIDEO
}

/// 价格模式：决定前台展示方式与后台必填项
enum PriceMode {
  /// 面议 / Contact for price —— 不展示数字价格
  NEGOTIABLE
  /// 固定价格 —— 使用 priceMin
  FIXED
  /// 价格区间 —— 使用 priceMin 与 priceMax
  RANGE
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  sku          String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverAssetId String?
  coverAsset   Asset?           @relation("ProductCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  featured     Boolean          @default(false)
  published    Boolean          @default(false)
  sortOrder    Int              @default(0)

  // ---- 价格与贸易信息（金额一律使用 Decimal，绝不使用 Float）----
  priceMode PriceMode @default(NEGOTIABLE)
  /// 计价货币：ISO 4217 代码（USD / CNY / VND / EUR）
  currency  String    @default("USD")
  /// 固定价格；区间价格的下限
  priceMin  Decimal?  @db.Decimal(12, 2)
  /// 区间价格的上限（仅 RANGE 使用）
  priceMax  Decimal?  @db.Decimal(12, 2)
  /// 计价单位：piece / meter / yard / roll / kg / set
  priceUnit String?
  /// 最小起订量
  moq       Int?
  /// 起订单位：与 priceUnit 取值一致
  moqUnit   String?

  /// 列表卡片鼠标悬停时播放的视频（必须引用 VIDEO 类型素材）
  hoverVideoAssetId String?
  hoverVideoAsset   Asset?  @relation("ProductHoverVideo", fields: [hoverVideoAssetId], references: [id], onDelete: SetNull)

  // ---- 草稿 ----
  //
  // 本模型上的各列、ProductTranslation、ProductSpecification、ProductMedia 一起构成
  // **线上内容** —— 前台读的就是它们，发布是唯一写入点。
  //
  // 后台的编辑先写进 draftData，与线上完全隔离：客人永远看不到改到一半的样子。
  // null 表示「没有待发布的改动」，此时编辑器直接编辑线上内容。
  /// 编辑草稿，形状与 ProductVersion.snapshot 相同（见 src/lib/product-draft.ts）
  draftData      Json?
  draftUpdatedAt DateTime?

  /// 发布后的可配置规格/颜色表，列和单元格内容按三种语言保存
  specTable      Json?

  /// 发布后的型号/颜色选项组；每个选项可绑定一张缩略图
  variantGroups  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations   ProductTranslation[]
  media          ProductMedia[]
  specifications ProductSpecification[]
  versions       ProductVersion[]

  @@index([published])
  @@index([featured])
  @@index([categoryId])
  @@index([sortOrder])
  @@index([hoverVideoAssetId])
}

/// 商品图库：有序、带用途的素材关联
model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role      ProductMediaRole @default(GALLERY)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@unique([productId, assetId, role])
  @@index([productId, sortOrder])
  @@index([assetId])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           Locale
  name             String
  shortDescription String?
  description      String?
  /// 尺寸摘要（如「宽 25mm × 厚 2mm」），独立于自由文本规格
  sizeSummary      String?
  spec             String?
  application      String?
  seoTitle         String?
  seoDescription   String?

  @@unique([productId, locale])
}

// ---------------------------------------------------------------------------
// 结构化商品参数
// ---------------------------------------------------------------------------

/// 一条可排序的商品参数（如材质、宽度、厚度、颜色、包装方式）。
/// 结构为 1 个商品 : N 条参数，每条参数三语言各一行翻译 —— 管理员可自由增删改排序，
/// 不允许把参数硬编码成固定数据库字段。
model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ProductSpecificationTranslation[]

  @@index([productId, sortOrder])
}

model ProductSpecificationTranslation {
  id              String               @id @default(cuid())
  specificationId String
  specification   ProductSpecification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  locale          Locale
  /// 参数名称（材质、宽度…）
  name            String
  /// 参数值
  value           String?

  @@unique([specificationId, locale])
}

/// 版本来源：发布时自动留下的，还是管理员手动存档的
enum ProductVersionKind {
  PUBLISHED
  MANUAL
}

/**
 * 商品的历史版本。
 *
 * 每次「发布」自动留一版，管理员也可以随时手动存档一版。每个商品**最多保留 3 个**，
 * 超出后最早的被挤掉（见 src/lib/admin/actions/products.ts 的 trimVersions）。
 *
 * 自动保存本身**不**产生版本 —— 否则几秒一存，三个名额只会是最近几秒的连续快照，
 * 回滚毫无意义。
 *
 * 恢复一个版本时，内容写回 Product.draftData 而**不是**直接改线上：
 * 恢复后它成为「待发布的改动」，确认无误再点发布，误点也能再退回去。
 */
model ProductVersion {
  id        String             @id @default(cuid())
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      ProductVersionKind
  /// 该版本的完整内容快照，与 Product.draftData 同一形状
  snapshot  Json
  /// 手动存档时可填备注
  note      String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// 询盘（本阶段仅保留模型，表单与邮件在阶段 5）
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  locale    String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([createdAt])
}
